# ── Firebase Web SDK (عميل — تُحقَن في bundle المتصفح عند البناء) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin / Auth REST (خادم فقط — لا تضف NEXT_PUBLIC_) ──
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── التطبيق ──
NEXT_PUBLIC_APP_URL=

# ── البريد (Resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── الدفع (Tap) ──
TAP_SECRET_KEY=

# ── OTP bridge (اختياري) ──
OTP_BRIDGE_SECRET=

# ── Capacitor (تطبيق الجوال) ──
# عنوان التطبيق المستضاف — يُحمَّل داخل WebView (وضع hybrid الافتراضي)
CAPACITOR_SERVER_URL=https://www.eysalk.com
