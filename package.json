{
  "name": "mastara-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:mobile:static": "node scripts/build-mobile.mjs --static",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios",
    "cap:assets": "npx capacitor-assets generate --ios --android --iconBackgroundColor '#F0F7FF' --splashBackgroundColor '#F0F7FF'",
    "build:capacitor": "npm run build:mobile && npm run cap:sync",
    "build:capacitor:static": "npm run build:mobile:static && npm run cap:sync",
    "dev:delete-user": "node --env-file=.env.local scripts/delete-auth-user.mjs",
    "firebase:deploy": "firebase deploy --project eysalk-2c7be"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
