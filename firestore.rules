rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tailor_profiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /tailor_customers/{docId} {
      allow read: if request.auth != null && resource.data.tailor_user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.tailor_user_id == request.auth.uid;
      allow update: if request.auth != null && resource.data.tailor_user_id == request.auth.uid;
    }

    match /invoices/{docId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.user_id == request.auth.uid;
    }

    match /organization_members/{docId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
    }

    match /organizations/{orgId} {
      allow read: if request.auth != null;
    }

    match /otp_sessions/{docId} {
      allow read, write: if false;
    }

    match /subscription_plans/{planId} {
      allow read: if true;
    }

    match /organization_subscriptions/{docId} {
      allow read: if request.auth != null;
    }

    match /billing_events/{docId} {
      allow read, write: if false;
    }
  }
}
